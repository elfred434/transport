APP_NAME="Agence de Transport de Colis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=transport_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- SMTP (email de réinitialisation de mot de passe) ---
# Si SMTP_USER/SMTP_PASS sont vides, le lien de reset est journalisé et
# renvoyé dans la réponse (mode développement).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Plateforme de transport (hérité de l'API PHP d'origine) ---
# Fuseau applicatif ; aligner la base de données en production (Africa/Porto-Novo).
APP_TIMEZONE=UTC

# Origine(s) autorisée(s) pour CORS : '*' ou liste séparée par virgules.
CORS_ORIGINS=*

# Durée de vie des jetons d'API (jours).
TOKEN_TTL_DAYS=30

# Taille maximale d'upload (octets). Nécessite upload_max_filesize >= valeur.
MAX_UPLOAD_SIZE=5242880

# URL publique du frontend (liens des emails).
# En dev : le SPA React sur http://localhost:8003. En production mono-domaine,
# laisser l'origine du site (les chemins *.html des liens sont redirigés par
# le SPA vers ses propres routes).
FRONTEND_URL=http://localhost:8003

# Racine du disque 'transport' (fichiers uploadés, sous-dossier uploads/).
# Par défaut : storage/ de l'application (backend/storage). En production,
# fixez un emplacement dédié hors du dépôt.
# TRANSPORT_STORAGE_PATH=/var/www/transport-storage

# URL de base des fichiers uploadés. Vide = URL relatives (/uploads/...),
# à utiliser quand le frontend et l'API sont servis sur le même domaine
# (proxy Vite en dev, Caddy en prod). Renseigner si domaines distincts.
TRANSPORT_APP_URL=
