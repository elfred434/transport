# ===== Frontend (Vite) =====
# En dev (npm run dev), VITE_API_TARGET sert au proxy Vite vers le backend local.
# En production (Vercel / npm run build), VITE_API_BASE_URL est utilisé directement.

# Dev (laisser par défaut)
VITE_API_TARGET=http://127.0.0.1:8000

# Production (URL HTTPS du backend Render une fois déployé)
VITE_API_BASE_URL=
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_SANDBOX=true
