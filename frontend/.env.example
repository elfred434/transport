# ============================================================
#  Transport.bj — Frontend Vite (.env)
#  Copier en ".env" ou ".env.local" dans frontend/
# ============================================================
#
# --- URL du backend API ---
# En DEV avec ngrok UNIQUE (recommandé) :
#   - ngrok http 5173  (vers le frontend)
#   - Vite proxifie automatiquement /api → http://127.0.0.1:8000
#   Donc PAS BESOIN de VITE_API_TARGET : laisser vide/commente.
#
# Si tu veux bypasser le proxy Vite et pointer directement le backend
# (par ex. un second tunnel ngrok vers :8000), décommenter :
# VITE_API_TARGET=https://xxxx-8000.ngrok-free.app
#
# En dev local sans ngrok (navigateur → localhost:5173 → Vite proxy → Django :8000) :
# VITE_API_TARGET=   (laisser vide, le proxy suffit)
VITE_API_TARGET=

# --- Kkiapay clé PUBLIQUE (celle que le frontend envoie au widget) ---
# Même valeur que KKIAPAY_PUBLIC_KEY du backend.
# Test public key sandbox ci-dessous (remplace par ta vraie clé) :
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_SANDBOX=true

# --- Google OAuth / One Tap ---
# MÊME Client ID que dans backend_django/.env → GOOGLE_CLIENT_ID
# À récupérer sur https://console.cloud.google.com/ → APIs & Services → Identifiants
VITE_GOOGLE_CLIENT_ID=
