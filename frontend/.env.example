# ===== Frontend (Vite) =====
# En dev (npm run dev), VITE_API_TARGET sert au proxy Vite vers le backend local.
# En production (Vercel / npm run build), VITE_API_BASE_URL est utilisé directement.

# Dev (laisser par défaut)
VITE_API_TARGET=http://127.0.0.1:8000

# Production (URL HTTPS du backend Render une fois déployé)
VITE_API_BASE_URL=

# FedaPay (nouvel agrégateur par défaut — clé PUBLIQUE pk_sandbox_… / pk_live_…).
# Les clés sont servies par le backend /api/fedapay/public-config,
# ceci n'est qu'un fallback local.
VITE_FEDAPAY_PUBLIC_KEY=
VITE_FEDAPAY_SANDBOX=true

# Kkiapay (conservé le temps de la migration, peut être laissé vide)
VITE_KKIAPAY_PUBLIC_KEY=
VITE_KKIAPAY_SANDBOX=true
