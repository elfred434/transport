# ============================================================
#  Transport.bj — Backend Django (.env)
#  Copier ce fichier en ".env" (dans backend_django/.env)
#  et remplacer les valeurs par tes vraies clés.
#  Les variables commentées sont optionnelles : laisser vide
#  fait fonctionner l'app en mode dev/simulé.
# ============================================================

# --- Application ---
APP_DEBUG=true
SECRET_KEY=django-insecure-dev-remplace-cle-en-production

# --- Base de données ---
# sqlite = zero config (db.sqlite3) — RECOMMANDÉ pour dev
# mysql  = besoin XAMPP/WAMP + paquet mysqlclient décommenté dans requirements.txt
DB_CONNECTION=sqlite
# DB_DATABASE=transport
# DB_USERNAME=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Commission / Business ---
COMMISSION_PLATEFORME=0.05      # 5% pour la plateforme, 95% transporteur
MONTANT_MIN_RETRAIT=1000        # XOF

# ============================================================
#  KKIA PAY  (https://kkiapay.com)
#  - Sandbox = true  → pas de vrai paiement, mode test
#  - Si cles vides   → fallback simulation automatique
#  - Clés à récupérer sur ton dashboard Kkiapay :
#      https://dashboard.kkiapay.com/#/developers
# ============================================================
KKIAPAY_SANDBOX=true
KKIAPAY_SKIP_SSL_VERIFY=true     # évite cURL 60 sur Windows/XAMPP
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=

# ============================================================
#  GOOGLE OAuth / One Tap  (bouton "Se connecter avec Google")
#  - Créer un projet : https://console.cloud.google.com/
#  - APIs & Services → Identifiants → "ID client OAuth 2.0"
#  - Type "Application Web"
#  - Origines JavaScript autorisées :
#       http://localhost:5173
#       https://880a-....ngrok-free.app   (ton URL ngrok)
#  - URI de redirection autorisée :
#       http://localhost:5173/auth/google/callback
#  - Copier le "Client ID" ci-dessous (même valeur à mettre dans frontend/.env)
#  - Le "Client Secret" est utile uniquement si tu ajoutes un flux OAuth
#    serveur classique (authorization code flow). Pour One Tap depuis le front,
#    le PUBLIC KEY (Client ID) suffit au backend pour valider le JWT.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_SKIP_SSL_VERIFY=true
GOOGLE_ALLOW_JWT_FALLBACK=true
