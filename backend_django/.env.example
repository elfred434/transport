# ============================================================
#  Transport.bj — Backend Django (.env)
#  Colonnes attendues : CLE=VALEUR   (pas de guillemets, pas d'espaces autour de =)
#  Les variables APP_KEY/MAIL_*/REDIS_*/BCRYPT_* c'étaient pour Laravel,
#  Django les ignore. Ne les recopie pas ici.
# ============================================================

APP_DEBUG=true
SECRET_KEY=django-insecure-dev-transport-bj-change-me-in-prod

# --- Base de donnees ---
# "sqlite" = zero config (recommandé)
# "mysql"  = XAMPP/WAMP/MariaDB 10.4+ (patch intégré dans settings.py)
DB_CONNECTION=mysql
DB_DATABASE=transport_db
DB_USERNAME=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Business ---
COMMISSION_PLATEFORME=0.05
MONTANT_MIN_RETRAIT=1000

# --- Kkiapay (SANDBOX) ---
# Attention : Django lit KKIAPAY_SECRET_KEY (Laravel lisait KKIAPAY_SECRET)
KKIAPAY_SANDBOX=true
KKIAPAY_SKIP_SSL_VERIFY=true
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=

# --- Google OAuth / One Tap ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_SKIP_SSL_VERIFY=true
GOOGLE_ALLOW_JWT_FALLBACK=true
