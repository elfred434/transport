# ============================================================
#  Transport.bj — Backend Django (.env)
#  Copier ce fichier en .env dans le meme dossier (backend_django/.env)
#  et adapter les valeurs au besoin. Rien n'est obligatoire: les valeurs
#  par defaut sont suffisantes pour demarrer en local avec SQLite.
# ============================================================

# --- Application ---
APP_DEBUG=true
SECRET_KEY=django-insecure-dev-change-me-in-production

# --- Base de donnees ---
# sqlite = zero config (fichier db.sqlite3, recommande pour dev)
# mysql  = besoin de XAMPP/WAMP + paquet mysqlclient
DB_CONNECTION=sqlite
# DB_DATABASE=transport
# DB_USERNAME=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Kkiapay (sandbox par defaut, sans cles = mode simulation) ---
KKIAPAY_SANDBOX=true
KKIAPAY_SKIP_SSL_VERIFY=true
# KKIAPAY_PUBLIC_KEY=
# KKIAPAY_PRIVATE_KEY=
# KKIAPAY_SECRET_KEY=

# --- Commission ---
COMMISSION_PLATEFORME=0.05
